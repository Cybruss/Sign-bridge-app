import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'native_landmarker_service.dart';
import 'package:tflite_flutter/tflite_flutter.dart';
import 'package:camera/camera.dart';

class SignToTextScreenV2 extends StatefulWidget {
  const SignToTextScreenV2({Key? key}) : super(key: key);

  @override
  State<SignToTextScreenV2> createState() => _SignToTextScreenV2State();
}

class _SignToTextScreenV2State extends State<SignToTextScreenV2> {
  Interpreter? _signModel;
  List<String> _labels = [];

  final List<List<double>> _landmarkBuffer = [];
  final int _sequenceLength = 30;

  String _currentSign = 'Waiting for detection...';
  double _confidence = 0.0;
  int _handCount = 0;
  bool _nativeAvailable = false;
  bool _modelLoaded = false;

  final List<String> _detectionHistory = [];
  final int _maxHistoryLength = 10;

  Timer? _pollTimer;
  int _framesProcessed = 0;

  // Camera
  CameraController? _cameraController;
  bool _cameraInitialized = false;
  List<CameraDescription> _cameras = [];
  int _currentCameraIndex = 0;

  @override
  void initState() {
    super.initState();
    _initialize();
  }

  Future<void> _initialize() async {
    try {
      print('Loading model...');
      await _loadModel();
      
      print('Initializing camera...');
      await _initCamera();
      
      print('Starting native...');
      _nativeAvailable = await NativeLandmarkerService.isAvailable();

      if (!_nativeAvailable) {
        final started = await NativeLandmarkerService.startNativeLandmarker();
        if (started) {
          await Future.delayed(const Duration(seconds: 1));
          _nativeAvailable = await NativeLandmarkerService.isAvailable();
        }
      }

      if (mounted) {
        setState(() {});
      }

      if (_nativeAvailable) {
        _startPolling();
      }
    } catch (e) {
      print('Error: $e');
    }
  }

  Future<void> _initCamera() async {
    try {
      _cameras = await availableCameras();
      if (_cameras.isEmpty) {
        print('No cameras found');
        return;
      }

      _currentCameraIndex = 0;
      _cameraController = CameraController(
        _cameras[_currentCameraIndex],
        ResolutionPreset.medium,
        enableAudio: false,
      );

      await _cameraController!.initialize();
      
      if (mounted) {
        setState(() {
          _cameraInitialized = true;
        });
      }
      print('✅ Camera initialized');
    } catch (e) {
      print('Camera init error: $e');
    }
  }

  Future<void> _switchCamera() async {
    if (_cameras.length < 2) return;
    
    try {
      await _cameraController?.dispose();
      _currentCameraIndex = (_currentCameraIndex + 1) % _cameras.length;
      
      _cameraController = CameraController(
        _cameras[_currentCameraIndex],
        ResolutionPreset.medium,
        enableAudio: false,
      );

      await _cameraController!.initialize();
      
      if (mounted) {
        setState(() {
          _cameraInitialized = true;
        });
      }
    } catch (e) {
      print('Switch camera error: $e');
    }
  }

      if (!_nativeAvailable) {
        final started = await NativeLandmarkerService.startNativeLandmarker();
        if (started) {
          await Future.delayed(const Duration(seconds: 1));
          _nativeAvailable = await NativeLandmarkerService.isAvailable();
        }
      }

      if (mounted) {
        setState(() {});
      }

      if (_nativeAvailable) {
        _startPolling();
      }
    } catch (e) {
      print('Error: $e');
    }
  }

  Future<void> _loadModel() async {
    try {
      _signModel = await Interpreter.fromAsset('assets/models/sign_language_model.tflite');
      final labelsData = await rootBundle.loadString('assets/models/labels.txt');
      _labels = labelsData.split('\n').map((l) => l.trim()).where((l) => l.isNotEmpty).toList();

      if (mounted) {
        setState(() {
          _modelLoaded = true;
        });
      }
      print('✅ Model loaded: ${_labels.length} classes');
    } catch (e) {
      print('Error loading model: $e');
    }
  }

  void _startPolling() {
    if (_pollTimer != null) return;
    _pollTimer = Timer.periodic(const Duration(milliseconds: 100), (_) async {
      await _processLandmarks();
    });
  }

  Future<void> _processLandmarks() async {
    try {
      if (!mounted) return;

      final count = await NativeLandmarkerService.getHandCount();
      if (count != _handCount) {
        if (mounted) setState(() => _handCount = count);
      }

      if (count == 0) {
        if (_landmarkBuffer.isNotEmpty) {
          _landmarkBuffer.clear();
          if (mounted) {
            setState(() {
              _currentSign = 'No hands detected';
              _confidence = 0.0;
            });
          }
        }
        return;
      }

      final landmarks = await NativeLandmarkerService.getLatestLandmarks();
      if (landmarks == null || landmarks.length != 63) return;

      _landmarkBuffer.add(landmarks);
      if (_landmarkBuffer.length > _sequenceLength) {
        _landmarkBuffer.removeAt(0);
      }

      if (mounted) {
        setState(() {
          _framesProcessed++;
        });
      }

      if (_landmarkBuffer.length == _sequenceLength && _modelLoaded && _signModel != null) {
        await _classifySign();
      }
    } catch (e) {
      print('Landmark error: $e');
    }
  }

  Future<void> _classifySign() async {
    if (_signModel == null || _labels.isEmpty) return;

    try {
      final flatInput = <double>[];
      for (var frame in _landmarkBuffer) {
        flatInput.addAll(frame);
      }

      final inputShape = _signModel!.getInputTensor(0).shape;
      var input;
      if (inputShape.length == 2) {
        input = [flatInput];
      } else if (inputShape.length == 3) {
        input = [_landmarkBuffer];
      } else {
        return;
      }

      final numClasses = _labels.length;
      final output = List.filled(1, List.filled(numClasses, 0.0));

      _signModel!.run(input, output);

      final probabilities = output[0] as List;
      double maxProb = 0.0;
      int maxIndex = 0;

      for (int i = 0; i < probabilities.length; i++) {
        final prob = (probabilities[i] as num).toDouble();
        if (prob > maxProb) {
          maxProb = prob;
          maxIndex = i;
        }
      }

      if (maxProb > 0.3 && maxIndex < _labels.length) {
        final detectedSign = _labels[maxIndex];
        if (mounted) {
          setState(() {
            _currentSign = detectedSign;
            _confidence = maxProb;

            if (_detectionHistory.isEmpty || _detectionHistory.last != detectedSign) {
              _detectionHistory.add(detectedSign);
              if (_detectionHistory.length > _maxHistoryLength) {
                _detectionHistory.removeAt(0);
              }
            }
          });
        }
      }
    } catch (e) {
      print('Classification error: $e');
    }
  }

  void _clearHistory() {
    if (mounted) {
      setState(() {
        _detectionHistory.clear();
        _currentSign = 'Waiting for detection...';
        _confidence = 0.0;
        _landmarkBuffer.clear();
      });
    }
  }

  @override
  void dispose() {
    _pollTimer?.cancel();
    _cameraController?.dispose();
    _signModel?.close();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return WillPopScope(
      onWillPop: () async {
        _pollTimer?.cancel();
        return true;
      },
      child: Scaffold(
        appBar: AppBar(
          title: const Text('Sign → Text'),
          actions: [
            if (_detectionHistory.isNotEmpty)
              IconButton(
                icon: const Icon(Icons.clear_all),
                onPressed: _clearHistory,
              ),
          ],
        ),
        body: Column(
          children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
              color: (_nativeAvailable && _modelLoaded) ? Colors.green[50] : Colors.orange[50],
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(
                        (_nativeAvailable && _modelLoaded) ? Icons.check_circle : Icons.info,
                        color: (_nativeAvailable && _modelLoaded) ? Colors.green : Colors.orange,
                        size: 20,
                      ),
                      const SizedBox(width: 8),
                      Text(
                        (_nativeAvailable && _modelLoaded) ? 'Ready' : 'Init...',
                        style: const TextStyle(fontWeight: FontWeight.bold),
                      ),
                    ],
                  ),
                  Row(
                    children: [
                      Icon(Icons.back_hand, size: 20, color: _handCount > 0 ? Colors.blue : Colors.grey),
                      const SizedBox(width: 4),
                      Text('$_handCount'),
                    ],
                  ),
                ],
              ),
            ),
            Expanded(
              flex: 2,
              child: Stack(
                children: [
                  // Camera preview
                  if (_cameraInitialized && _cameraController != null)
                    SizedBox.expand(
                      child: FittedBox(
                        fit: BoxFit.cover,
                        child: SizedBox(
                          width: _cameraController!.value.previewSize!.height,
                          height: _cameraController!.value.previewSize!.width,
                          child: CameraPreview(_cameraController!),
                        ),
                      ),
                    )
                  else
                    Container(
                      color: Colors.black12,
                      child: const Center(
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            CircularProgressIndicator(),
                            SizedBox(height: 16),
                            Text('Initializing camera...', style: TextStyle(fontSize: 16)),
                          ],
                        ),
                      ),
                    ),
                  
                  // Camera switch button
                  if (_cameras.length > 1 && _cameraInitialized)
                    Positioned(
                      top: 16,
                      right: 16,
                      child: FloatingActionButton(
                        mini: true,
                        onPressed: _switchCamera,
                        backgroundColor: Colors.black54,
                        child: const Icon(Icons.flip_camera_android, color: Colors.white),
                      ),
                    ),
                ],
              ),
            ),
            Expanded(
              flex: 1,
              child: Container(
                color: Colors.blue[50],
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text('Detection', style: TextStyle(fontSize: 14, color: Colors.grey)),
                        Text('Buffer: ${_landmarkBuffer.length}/$_sequenceLength', style: const TextStyle(fontSize: 12, color: Colors.grey)),
                      ],
                    ),
                    const SizedBox(height: 8),
                    Expanded(
                      child: Center(
                        child: Text(
                          _currentSign,
                          style: TextStyle(
                            fontSize: 48,
                            fontWeight: FontWeight.bold,
                            color: _confidence > 0.7 ? Colors.green : _confidence > 0.5 ? Colors.orange : Colors.grey[400],
                          ),
                          textAlign: TextAlign.center,
                        ),
                      ),
                    ),
                    if (_confidence > 0)
                      Column(
                        children: [
                          LinearProgressIndicator(
                            value: _confidence.clamp(0.0, 1.0),
                            minHeight: 8,
                          ),
                          const SizedBox(height: 4),
                          Text('${(_confidence * 100).toStringAsFixed(0)}%', style: const TextStyle(fontSize: 12)),
                        ],
                      ),
                  ],
                ),
              ),
            ),
            Expanded(
              flex: 2,
              child: Container(
                color: Colors.grey[100],
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Container(
                      padding: const EdgeInsets.all(12),
                      color: Colors.white,
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          const Text('Output', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                          Text('${_detectionHistory.length} signs', style: const TextStyle(fontSize: 12, color: Colors.grey)),
                        ],
                      ),
                    ),
                    Expanded(
                      child: _detectionHistory.isEmpty
                          ? const Center(child: Text('Waiting...'))
                          : ListView.builder(
                              reverse: true,
                              itemCount: _detectionHistory.length,
                              itemBuilder: (context, index) {
                                final sign = _detectionHistory[_detectionHistory.length - 1 - index];
                                return Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                                  decoration: BoxDecoration(border: Border(bottom: BorderSide(color: Colors.grey[300]!))),
                                  child: Row(
                                    children: [
                                      Container(
                                        width: 32,
                                        height: 32,
                                        decoration: BoxDecoration(shape: BoxShape.circle, color: Colors.blue[100]),
                                        child: Center(
                                          child: Text('${_detectionHistory.length - index}', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 12)),
                                        ),
                                      ),
                                      const SizedBox(width: 16),
                                      Expanded(child: Text(sign, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w500))),
                                    ],
                                  ),
                                );
                              },
                            ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
